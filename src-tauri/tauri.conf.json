{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AntigravityNexus",
  "version": "1.0.0",
  "identifier": "com.antigravity.nexus",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Nexus",
        "width": 440,
        "height": 690,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
